# === Certificados e chaves (NUNCA versionar) ===
# Ignora os ARQUIVOS de certificado/chave por extensao, mas mantem a PASTA
# certificates/ versionada (com o README) para o docker-compose montar e para
# documentar quais arquivos colocar.
*.key
*.pem
*.pem.key
*.pem.crt
*.crt
*.der
*.bin
*private*
certificates/*
!certificates/README.md
!**/certificates/README.md

# === Sistema operacional ===
.DS_Store
**/.DS_Store
Thumbs.db

# === Python ===
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# === Node ===
node_modules/

# === Logs / temporários ===
*.log
*.tmp
